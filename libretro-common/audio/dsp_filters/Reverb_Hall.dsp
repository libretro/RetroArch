# damping = 0.42, diffusion = 0.72, early_mix = 0.42, late_mix = 0.78,
# width = 1.15, drywet = 0.35
earlyreverb_predelay_ms = 24.0
earlyreverb_room_size = 1.45
earlyreverb_decay_sec = 4.8
earlyreverb_damping = 0.36
earlyreverb_diffusion = 0.86
earlyreverb_early_mix = 0.38
earlyreverb_late_mix = 0.92
earlyreverb_width = 1.35
earlyreverb_drywet = 0.38
