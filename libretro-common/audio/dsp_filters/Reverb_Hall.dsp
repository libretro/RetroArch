filters = 1
filter0 = earlyreverb

# predelay_ms: 0-250, room_size: 0.45-2.25, decay_sec: 0.2-20,
# damping: 0.0-0.98, diffusion: 0.0-1.0, early_mix/late_mix: 0.0-1.5,
# width: 0.0-2.0, drywet: 0.0-1.0
