# damping = 0.42, diffusion = 0.72, early_mix = 0.42, late_mix = 0.78,
# width = 1.15, drywet = 0.35
earlyreverb_predelay_ms = 12.0
earlyreverb_room_size = 0.82
earlyreverb_decay_sec = 1.7
earlyreverb_damping = 0.52
earlyreverb_diffusion = 0.70
earlyreverb_early_mix = 0.55
earlyreverb_late_mix = 0.68
earlyreverb_width = 1.05
earlyreverb_drywet = 0.28
