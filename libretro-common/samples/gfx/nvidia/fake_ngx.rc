/* The stand-in core's version resource, with OptiScaler's product
 * name: what ngx_loader.c looks for when its calls may be answered by
 * OptiScaler loaded under one of the proxy names. */
1 VERSIONINFO
FILEVERSION 0,7,7,0
PRODUCTVERSION 0,7,7,0
BEGIN
   BLOCK "StringFileInfo"
   BEGIN
      BLOCK "040904b0"
      BEGIN
         VALUE "FileDescription", "OptiScaler"
         VALUE "ProductName", "OptiScaler"
         VALUE "ProductVersion", "0.7.7-test"
      END
   END
   BLOCK "VarFileInfo"
   BEGIN
      VALUE "Translation", 0x409, 1200
   END
END
