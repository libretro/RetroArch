/* The stand-in feature library's file version, as the real one carries
 * its own: what ngx_loader.c reads on Windows */
1 VERSIONINFO
FILEVERSION 310,2,1,0
PRODUCTVERSION 310,2,1,0
BEGIN
   BLOCK "StringFileInfo"
   BEGIN
      BLOCK "040904b0"
      BEGIN
         VALUE "FileDescription", "NVIDIA DLSS stand-in"
         VALUE "FileVersion", "310.2.1.0"
      END
   END
   BLOCK "VarFileInfo"
   BEGIN
      VALUE "Translation", 0x409, 1200
   END
END
