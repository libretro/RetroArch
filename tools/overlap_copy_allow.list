# tools/overlap_copy_allow.list
#
# Allowlist for tools/overlap_copy_check.c: same-buffer copy calls
# that were audited by hand and are safe by construction. One entry
# per line: file|function|dst-base|src-base (bases as normalized by
# the checker). An entry allows that combination anywhere in the
# file, so line churn never invalidates it; the checker warns about
# entries that stop matching so this list cannot rot.
#
# Every entry below was audited in the e942ee2 sweep. The recurring
# safe patterns are:
#  - LZ-style self-copies with explicit disjoint/periodic-chunk
#    guards (r7z_lzma, encoding_vcdiff, encoding_rlz4, encoding_rzstd,
#    task_patch BPS TARGET_COPY)
#  - copies between provably distinct elements/rows/members of one
#    array or struct (decoder state rotation, dirs[] defaults,
#    channel/grid structs)
#  - single-element shifts in correctly-directed loops (netplay chat,
#    cheat list)
#  - row-duplication at exactly one stride of distance (ntsc_crt,
#    sdl_rs90, ctr_svchax cache flush)
#
# Exact-alias findings (dst text == src text) are never allowlisted;
# fix those with memmove, a staging buffer, or an alias-guarded
# helper instead.
audio/drivers/wiiu_audio.c|memcpy|offsets|offsets
os/ctr/ctr_svchax.c|memcpy|flush_buffer|flush_buffer
frontend/drivers/platform_gx_libogc.c|strlcpy|g_defaults.dirs|g_defaults.dirs
gfx/drivers/sdl_rs90_gfx.c|memcpy|target|target
gfx/video_filters/ntsc_crt.c|memcpy|v->out|v->out
libretro-common/encodings/encoding_rlz4.c|memcpy|to|to
libretro-common/encodings/encoding_rlz4.c|rlz4_copy_match_blind|dst|dst
# rzstd_match_copy: each copy it makes is disjoint -- periods doubled
# while short, 16 and 8-byte words staged through a local, wide copies
# only from 32 or more bytes back
libretro-common/encodings/encoding_rzstd.c|rzstd_match_copy|dst|dst
libretro-common/encodings/encoding_vcdiff.c|memcpy|d->out|d->out
libretro-common/formats/7z/r7z_lzma.c|memcpy|dst|dst
libretro-common/formats/aac/raac.c|memcpy|c->bs_invf_mode|c->bs_invf_mode
libretro-common/formats/aac/raac.c|memcpy|c->env_facs_q|c->env_facs_q
libretro-common/formats/aac/raac.c|memcpy|c->noise_facs_q|c->noise_facs_q
libretro-common/formats/aac/raac.c|memcpy|c->s_indexmapped|c->s_indexmapped
libretro-common/formats/aac/raac.c|memcpy|q->W|q->W
libretro-common/formats/aac/raac.c|memcpy|q->Y|q->Y
libretro-common/formats/aac/raac.c|memcpy|q->g_temp|q->g_temp
libretro-common/formats/aac/raac.c|memcpy|q->q_temp|q->q_temp
libretro-common/formats/aac/raac.c|memcpy|s->d|s->d
libretro-common/formats/aac/raac.c|raac_decode_cpe|a->ch|a->ch
libretro-common/formats/aac/raac.c|raac_sbr_copy_grid|s->d|s->d
libretro-common/formats/atrac3/ratrac3.c|memcpy|d->js_sel|d->js_sel
libretro-common/formats/mp3/rmp3.c|memcpy|dst|dst
libretro-common/formats/opus/ropus.c|memcpy|buf|buf
libretro-common/formats/opus/ropus.c|memcpy|ctrl->PredCoef_Q12|ctrl->PredCoef_Q12
libretro-common/formats/opus/ropus.c|memcpy|oldBandE|oldBandE
libretro-common/formats/opus/ropus.c|memcpy|sLPC_Q14|sLPC_Q14
libretro-common/include/array/rhmap.h|memcpy|((char*)(hdr + 1))|((char*)(hdr + 1))
menu/cbs/menu_cbs_ok.c|memcpy|cheat_manager_state.cheats|cheat_manager_state.cheats
network/netplay/netplay_frontend.c|memcpy|chat->messages|chat->messages
network/netplay/netplay_frontend.c|memcpy|netplay->buffer|netplay->buffer
tasks/task_patch.c|memcpy|bps.target_data|bps.target_data
ui/drivers/ui_qt_widgets.cpp|memcpy|menu_shader->pass|menu_shader->pass
ui/drivers/ui_qt_widgets.cpp|memcpy|video_shader->pass|video_shader->pass
# rinf_build doubles the fast table in place: fast[cur..2cur) from
# fast[0..cur), disjoint halves of one array
libretro-common/encodings/encoding_deflate.c|memcpy|h->fast|h->fast
libretro-common/encodings/encoding_deflate.c|memcpy|h->pfast|h->pfast
# place_d[2].name from place_d[1].name: distinct elements
samples/gfx/video_windows/video_windows_test.c|memcpy|place_d|place_d
# raac parametric stereo: a parameter row from another row (src != num_env
# is checked), matrix [0] from [num_env_old] (num_env_old > 0 is checked),
# and in_buf[i][32..37] down to [0..5]: always distinct ranges
libretro-common/formats/aac/raac.c|memcpy|ps->iid_par|ps->iid_par
libretro-common/formats/aac/raac.c|memcpy|ps->icc_par|ps->icc_par
libretro-common/formats/aac/raac.c|memcpy|ps->ipd_par|ps->ipd_par
libretro-common/formats/aac/raac.c|memcpy|ps->opd_par|ps->opd_par
libretro-common/formats/aac/raac.c|memcpy|ps->in_buf|ps->in_buf
libretro-common/formats/aac/raac.c|memcpy|ps->H|ps->H
