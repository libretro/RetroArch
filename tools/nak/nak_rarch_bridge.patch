--- /dev/null
+++ b/src/nouveau/compiler/nak_rarch_bridge.c
@@ -0,0 +1,146 @@
+/* RetroArch's bridge to NAK, applied to a Mesa tree by
+ * RetroArch's tools/gen_nak_shaders.sh: one SPIR-V stage of the
+ * Switch driver's menu pipeline to SM 8.6 code, deko3d's resource
+ * layout kept - uniform block n in c[2+n], the fragment stage's
+ * texture n by the handle at c[0][0x690+4n] - behind a plain C
+ * interface the generator calls without Mesa's headers. */
+#include <stdlib.h>
+#include <string.h>
+#include "nir.h"
+#include "nir_builder.h"
+#include "compiler/glsl_types.h"
+#include "spirv/nir_spirv.h"
+#include "nak.h"
+#include "nv_device_info.h"
+
+/* As the generator declares it */
+struct nak_rarch_shader
+{
+   unsigned        num_gprs;
+   unsigned        slm_size;
+   unsigned        code_size;
+   unsigned        early_fragment_tests;
+   uint32_t        hdr[32];
+   const uint32_t *code;
+   const char     *asm_str;
+};
+
+int nak_rarch_compile(const uint32_t *spirv, size_t words, int frag,
+      struct nak_rarch_shader *out);
+
+/* NVK provides these; only sample positions read them, which the menu
+ * shaders never take */
+const struct nak_constant_offset_info nak_const_offsets_base = { 0 };
+const struct nak_constant_offset_info nak_const_offsets_turing_graphics = { 0 };
+
+static bool lower_res(nir_builder *b, nir_instr *instr, void *data)
+{
+   b->cursor = nir_before_instr(instr);
+   if (instr->type == nir_instr_type_intrinsic)
+   {
+      nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+      switch (in->intrinsic)
+      {
+         case nir_intrinsic_vulkan_resource_index:
+            nir_def_replace(&in->def, nir_vec2(b,
+                  nir_iadd_imm(b, in->src[0].ssa, 2 + nir_intrinsic_binding(in)),
+                  nir_imm_int(b, 0)));
+            return true;
+         case nir_intrinsic_load_vulkan_descriptor:
+            nir_def_replace(&in->def, in->src[0].ssa);
+            return true;
+         case nir_intrinsic_load_ubo:
+            nir_def_replace(&in->def, nir_ldc_nv(b, in->num_components,
+                  in->def.bit_size, in->src[0].ssa, in->src[1].ssa,
+                  .align_mul = nir_intrinsic_align_mul(in),
+                  .align_offset = nir_intrinsic_align_offset(in)));
+            return true;
+         default:
+            return false;
+      }
+   }
+   if (instr->type == nir_instr_type_tex)
+   {
+      nir_tex_instr *tex = nir_instr_as_tex(instr);
+      int i = nir_tex_instr_src_index(tex, nir_tex_src_texture_deref);
+      nir_variable *v;
+      nir_def *h;
+      if (i < 0)
+         return false;
+      v = nir_deref_instr_get_variable(nir_src_as_deref(tex->src[i].src));
+      h = nir_ldc_nv(b, 1, 32, nir_imm_int(b, 0),
+            nir_imm_int(b, 0x690 + 4 * v->data.binding), .align_mul = 4);
+      nir_src_rewrite(&tex->src[i].src, h);
+      tex->src[i].src_type = nir_tex_src_texture_handle;
+      i = nir_tex_instr_src_index(tex, nir_tex_src_sampler_deref);
+      if (i >= 0)
+         nir_tex_instr_remove_src(tex, i);
+      return true;
+   }
+   return false;
+}
+
+int nak_rarch_compile(const uint32_t *spirv, size_t words, int frag,
+      struct nak_rarch_shader *out)
+{
+   static struct nak_compiler *nak;
+   struct nv_device_info dev;
+   struct spirv_to_nir_options so;
+   struct nak_fs_key fk;
+   struct nak_shader_bin *bin;
+   mesa_shader_stage st = frag ? MESA_SHADER_FRAGMENT : MESA_SHADER_VERTEX;
+   nir_shader *s;
+
+   if (!nak)
+   {
+      memset(&dev, 0, sizeof(dev));
+      dev.type             = NV_DEVICE_TYPE_SOC;
+      dev.sm               = 86;     /* T239: SPA 8.6, as drako3d sets */
+      dev.cls_eng3d        = 0xC797; /* AMPERE_B */
+      dev.cls_compute      = 0xC7C0;
+      dev.max_warps_per_mp = 48;
+      glsl_type_singleton_init_or_ref();
+      nak = nak_compiler_create(&dev);
+   }
+   memset(&so, 0, sizeof(so));
+   so.environment            = NIR_SPIRV_VULKAN;
+   so.ubo_addr_format        = nir_address_format_32bit_index_offset;
+   so.ssbo_addr_format       = nir_address_format_32bit_index_offset;
+   so.push_const_addr_format = nir_address_format_32bit_offset;
+   so.shared_addr_format     = nir_address_format_32bit_offset;
+   so.global_addr_format     = nir_address_format_64bit_global;
+   so.temp_addr_format       = nir_address_format_32bit_offset;
+   so.constant_addr_format   = nir_address_format_64bit_global;
+   s = spirv_to_nir(spirv, words, NULL, st, "main", &so, nak_nir_options(nak));
+   if (!s)
+      return -1;
+   NIR_PASS(_, s, nir_lower_variable_initializers, nir_var_function_temp);
+   NIR_PASS(_, s, nir_lower_returns);
+   NIR_PASS(_, s, nir_inline_functions);
+   nir_remove_non_entrypoints(s);
+   NIR_PASS(_, s, nir_opt_deref);
+   NIR_PASS(_, s, nir_lower_variable_initializers, ~0);
+   NIR_PASS(_, s, nir_split_var_copies);
+   NIR_PASS(_, s, nir_split_per_member_structs);
+   NIR_PASS(_, s, nir_remove_dead_variables,
+         nir_var_shader_in | nir_var_shader_out | nir_var_system_value, NULL);
+   nak_preprocess_nir(s, nak);
+   NIR_PASS(_, s, nir_lower_explicit_io, nir_var_mem_ubo,
+         nir_address_format_32bit_index_offset);
+   NIR_PASS(_, s, nir_shader_instructions_pass, lower_res,
+         nir_metadata_control_flow, NULL);
+   NIR_PASS(_, s, nir_opt_constant_folding);
+   NIR_PASS(_, s, nir_opt_dce);
+   nir_shader_gather_info(s, nir_shader_get_entrypoint(s));
+   memset(&fk, 0, sizeof(fk));
+   if (!(bin = nak_compile_shader(s, true, nak, 0, frag ? &fk : NULL, false)))
+      return -1;
+   out->num_gprs             = bin->info.num_gprs;
+   out->slm_size             = bin->info.slm_size;
+   out->code_size            = bin->code_size;
+   out->early_fragment_tests = frag && s->info.fs.early_fragment_tests;
+   memcpy(out->hdr, bin->info.hdr, sizeof(out->hdr));
+   out->code    = (const uint32_t*)bin->code;
+   out->asm_str = bin->asm_str;
+   return 0;
+}
