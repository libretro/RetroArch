# Lock acquisitions allowed inside each function's own block, as
# tools/lock_acquire_budget.sh counts them off the release objects.
# Measured with gcc -O3 on x86-64. A count here is a ceiling, not a
# target: the ones that are not zero are the passes that genuinely have
# something to coordinate.
#
# function                       allowed
video_thread_presenter_stats     0
video_thread_latency_stats       0
video_thread_pacing_stats        0
video_thread_swap_count          0
thread_get_refresh_rate          0
# The write that keeps read_vp following the viewport it reports, so
# CMD_READ_VIEWPORT's compare stays truthful. Skipped on the polls
# where the viewport has not changed, which is all of them but a
# resize.
video_thread_viewport_info       1
# The handoff runs on the ring word and eventcounts; nothing here.
video_thread_frame               0
# The video thread's pass: the command copy, the upload list's take and
# per-node put, and the menu-texture handoff, each behind a test that
# is false on a pass with only a frame to draw.
video_thread_loop                6
# Parks and handshakes ride an eventcount and atomic words; nothing here.
audio_thread_loop                0
# Taken once it has something to retire; returns on two atomic loads
# before any of them on a frame with nothing in flight.  The progress
# walk also counts the due main-thread tasks; picking and settling one
# (inlined here) takes the lock only when such a task is due.
retro_task_threaded_gather       8
video_driver_frame               0
audio_driver_sample_batch        0
runloop_iterate                  0
# The emulated mailbox's acquire thread: atomic words and eventcounts.
vulkan_emulated_mailbox_loop     0
# queue_lock around vkQueuePresentKHR, dropped when it returns.
vulkan_present                   1
# None on a frame. The one is queue_lock around the submission that
# empties a full stale-acquire list (vulkan_consume_stale_acquires,
# inlined here).
vulkan_acquire_next_image        1
