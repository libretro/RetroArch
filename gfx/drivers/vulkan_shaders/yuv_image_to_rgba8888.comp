#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D Y;
layout(set = 0, binding = 2) uniform sampler2D C;
layout(set = 0, binding = 3, rgba8) writeonly uniform image2D uImage;
layout(set = 0, binding = 4, std430) readonly buffer SSBO { uint words[]; };
void main()
{
   uvec2 p = gl_GlobalInvocationID.xy;
   if (p.x >= words[0] || p.y >= words[1]) return;
   ivec2 origin = ivec2(words[2], words[3]);
   float scale = words[14] == 2u ? 65535.0 / (words[15] != 0u ? 65472.0 : 65280.0) : 1.0;
   float center = words[14] == 2u && words[15] != 0u ? 512.0 / 1023.0 : 128.0 / 255.0;
   float y = texelFetch(Y, ivec2(p) + origin, 0).r * scale;
   vec2 c = texelFetch(C, (ivec2(p) + origin) >> 1, 0).rg * scale - center;
   vec3 rgb = vec3(uintBitsToFloat(words[8]) * y + uintBitsToFloat(words[9]));
   rgb += vec3(uintBitsToFloat(words[10]) * c.y,
         uintBitsToFloat(words[11]) * c.x + uintBitsToFloat(words[12]) * c.y,
         uintBitsToFloat(words[13]) * c.x);
   imageStore(uImage, ivec2(p), vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
