# Its own object folder: the other Makefiles here build the same
# sources with other flags
SAMPLE_OBJDIR := obj-signed
include ../../sample_objdir.mk

TARGET := signed_install_test

# The core updater checks every download: .sig first, the core staged,
# checked and only then installed; Update Installed Cores carries on
# past a refused core. The real updater, HTTP, backup and trust store
# code against a loopback server. TEST_KEY=0: no keys, today's download.
# COMPRESSION=1 also serves a zip; mingw-w64 builds without zlib.
#
#   make -f Makefile.signed_install check
#   make -f Makefile.signed_install check SANITIZER=address,undefined
#   make -f Makefile.signed_install check SANITIZER=thread
CORE_DIR          := ../../..
LIBRETRO_COMM_DIR := $(CORE_DIR)/libretro-common
TEST_KEY          ?= 1
COMPRESSION       ?= 1

ifneq ($(findstring mingw,$(CC)),)
   EXE         := .exe
   COMPRESSION := 0
   LIBS        += -lws2_32
else
   EXE  :=
   LIBS += -lpthread
endif

SOURCES := \
	signed_install_test.c \
	../core_updater/stubs_retroarch.c \
	$(CORE_DIR)/tasks/task_core_updater.c \
	$(CORE_DIR)/tasks/task_core_backup.c \
	$(CORE_DIR)/tasks/task_nbio_slice.c \
	$(CORE_DIR)/tasks/task_http.c \
	$(CORE_DIR)/core_updater_list.c \
	$(CORE_DIR)/core_backup.c \
	$(CORE_DIR)/core_install_check.c \
	$(CORE_DIR)/core_trust_runtime.c \
	$(CORE_DIR)/core_signature.c \
	$(CORE_DIR)/core_signature_io.c \
	$(LIBRETRO_COMM_DIR)/crypto/pk.c \
	$(LIBRETRO_COMM_DIR)/crypto/crypto.c \
	$(LIBRETRO_COMM_DIR)/crypto/kdf.c \
	$(LIBRETRO_COMM_DIR)/hash/lrc_hash.c \
	$(LIBRETRO_COMM_DIR)/queues/task_queue.c \
	$(LIBRETRO_COMM_DIR)/net/net_http.c \
	$(LIBRETRO_COMM_DIR)/net/net_compat.c \
	$(LIBRETRO_COMM_DIR)/net/net_socket.c \
	$(LIBRETRO_COMM_DIR)/lists/dir_list.c \
	$(LIBRETRO_COMM_DIR)/lists/string_list.c \
	$(LIBRETRO_COMM_DIR)/compat/compat_strl.c \
	$(LIBRETRO_COMM_DIR)/compat/compat_strldup.c \
	$(LIBRETRO_COMM_DIR)/compat/compat_strcasestr.c \
	$(LIBRETRO_COMM_DIR)/compat/compat_posix_string.c \
	$(LIBRETRO_COMM_DIR)/compat/fopen_utf8.c \
	$(LIBRETRO_COMM_DIR)/string/stdstring.c \
	$(LIBRETRO_COMM_DIR)/string/rstrtod.c \
	$(LIBRETRO_COMM_DIR)/file/file_path.c \
	$(LIBRETRO_COMM_DIR)/file/file_path_io.c \
	$(LIBRETRO_COMM_DIR)/file/retro_dirent.c \
	$(LIBRETRO_COMM_DIR)/streams/file_stream.c \
	$(LIBRETRO_COMM_DIR)/streams/interface_stream.c \
	$(LIBRETRO_COMM_DIR)/streams/memory_stream.c \
	$(LIBRETRO_COMM_DIR)/utils/md5.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_crc32.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_utf.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_base64.c \
	$(LIBRETRO_COMM_DIR)/vfs/vfs_implementation.c \
	$(LIBRETRO_COMM_DIR)/features/features_cpu.c \
	$(LIBRETRO_COMM_DIR)/rthreads/rthreads.c \
	$(LIBRETRO_COMM_DIR)/rthreads/retro_eventcount.c \
	$(LIBRETRO_COMM_DIR)/time/rtime.c

CFLAGS += -Wall -std=gnu99 -g1 -O1 -fno-omit-frame-pointer \
          -I$(LIBRETRO_COMM_DIR)/include -I$(CORE_DIR) -I$(CORE_DIR)/deps \
          -DHAVE_THREADS -DHAVE_NETWORKING -DRARCH_INTERNAL -DHAVE_MENU \
          -DHAVE_UPDATE_CORES -DHAVE_ONLINE_UPDATER -DSTUBS_REAL_CORE_BACKUP \
          -DHAVE_CRYPTO -DHAVE_DYNAMIC -DHAVE_CORE_SIGNATURES
ifeq ($(TEST_KEY),1)
   CFLAGS += -DHAVE_CORE_SIGNING_TEST_KEY
endif
ifeq ($(COMPRESSION),1)
   CFLAGS  += -DHAVE_COMPRESSION -DHAVE_ZLIB
   SOURCES += \
	$(CORE_DIR)/tasks/task_decompress.c \
	$(LIBRETRO_COMM_DIR)/file/archive_file.c \
	$(LIBRETRO_COMM_DIR)/file/archive_file_zlib.c \
	$(LIBRETRO_COMM_DIR)/streams/rzip_stream.c \
	$(LIBRETRO_COMM_DIR)/streams/trans_stream.c \
	$(LIBRETRO_COMM_DIR)/streams/trans_stream_pipe.c \
	$(LIBRETRO_COMM_DIR)/streams/trans_stream_zlib.c \
	$(LIBRETRO_COMM_DIR)/streams/trans_stream_deflate.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_deflate.c
   LIBS    += -lz
endif
LIBS += -lm

OBJS := $(call sample_objs,$(SOURCES:.c=.o))

ifneq ($(SANITIZER),)
   CFLAGS  := -fsanitize=$(SANITIZER) $(CFLAGS)
   LDFLAGS := -fsanitize=$(SANITIZER) $(LDFLAGS)
endif

all: $(TARGET)$(EXE)

%.o: %.c
	$(CC) -c -o $@ $< $(CFLAGS)

$(SAMPLE_OBJDIR)/%.o: $$(call sample_src,$$*).c
	@mkdir -p $(@D)
	$(CC) -c -o $@ $< $(CFLAGS)

$(TARGET)$(EXE): $(OBJS)
	$(CC) -o $@ $^ $(LDFLAGS) $(LIBS)

check: all
	rm -rf signed_install_test_tmp
	$(RUNNER) ./$(TARGET)$(EXE)

clean:
	rm -rf $(SAMPLE_OBJDIR) signed_install_test_tmp
	rm -f $(TARGET) $(TARGET).exe signed_install_test.o

.PHONY: all check clean
