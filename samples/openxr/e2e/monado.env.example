# Monado for run.py: pass this file, or a copy with your changes.
# The null compositor and simulated headset need no hardware; Monado
# 25.1 runs them only as a service. XR_RUNTIME_JSON selects Monado for
# these runs alone: the system's active runtime is never changed.
MODE=service
# Monado's manifest where the distribution installs it.
RUNTIME_JSON=/usr/share/openxr/1/openxr_monado.json
CLIENT_ENV=""
SERVICE_ENV="XRT_COMPOSITOR_NULL=1 SIMULATED_ENABLE=1 XRT_NO_STDIN=1"
SERVICE_SOCKET=monado_comp_ipc
# Relative to this file; validation-baseline.txt next to run.py if unset.
#VALIDATION_BASELINE=validation-baseline.txt
