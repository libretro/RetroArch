# A line after the expect-stuck frame: the run ends in a release in that
# frame, so the line would never act.
# error: past_stuck.scn:11: a line after the expect-stuck frame never acts
console 0 core=test
console 1 core=test
option 1 link_test_mode never_advance
option 1 link_test_bad_frame 5
expect-stuck 5
expect-count skipped_publish 1
0 cable 0:0 1:0
10 expect 0 system 8 1
20 end
