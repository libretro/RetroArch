# A core that logs an error while it finishes a frame the bus released
# fails the run: console 1 is parked at 600, the last step, so closing the
# session abandons its frame, and it errs on the release it is told of.
# error: console 1: errors logged: 6
console 0 core=test
console 1 core=test
console 2 core=test
option 0 link_test_fps 60000/1001
option 0 link_test_rate_0 60000
option 0 link_test_lookahead_0 1
option 1 link_test_ports 2
option 1 link_test_fps 16777216/280896
option 1 link_test_rate_0 16777216
option 1 link_test_rate_1 16777216
option 1 link_test_mode release_error
option 2 link_test_fps 16777216/280896
option 2 link_test_rate_0 16777216
0 cable 0:0 1:0
0 cable 1:1 2:0
600 end
