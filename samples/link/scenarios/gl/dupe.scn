# twin: render_dupe
# One console that draws in OpenGL and passes no picture in frames 40 to
# 50: its framebuffer holds the first part of each, and the harness keeps
# the picture it read back in frame 39.
console 0 core=test render=gl
option 0 link_test_render gl
option 0 link_test_dupe_frames 40-50
30 save mid
40 checkpoint before
41 checkpoint dupe
60 checkpoint after
90 end
