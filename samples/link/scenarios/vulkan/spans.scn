# twin: render_spans
# render_spans with every console drawing in Vulkan: consoles 1 and 2 are
# saved inside a frame at 270, between the two parts of their pictures,
# and are inside a frame again at 600, where every run abandons those
# frames before it unloads the cores. Console 1 passes its picture with
# semaphores both ways; console 2 hands part 1's command buffer over for
# the frontend to submit.
console 0 core=test render=vulkan
console 1 core=test render=vulkan
console 2 core=test render=vulkan
option 0 link_test_render vulkan
option 0 link_test_fps 60000/1001
option 0 link_test_rate_0 60000
option 0 link_test_lookahead_0 1
option 1 link_test_render vulkan
option 1 link_test_vk_handoff semaphore
option 1 link_test_ports 2
option 1 link_test_fps 16777216/280896
option 1 link_test_rate_0 16777216
option 1 link_test_rate_1 16777216
option 1 link_test_save_in_advance on
option 2 link_test_render vulkan
option 2 link_test_vk_handoff commands
option 2 link_test_fps 16777216/280896
option 2 link_test_rate_0 16777216
option 2 link_test_save_in_advance on
input 1 0 ../spans_save_in_advance_c1.inp
input 2 0 ../spans_save_in_advance_c2.inp
0 cable 0:0 1:0
0 cable 1:1 2:0
270 save mid
270 checkpoint in_flight
600 checkpoint last
600 end
