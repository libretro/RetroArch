# One console that passes no picture in frames 40 to 50: it draws the
# first part of each and no second, and the checkpoint at 41 keeps its
# picture of frame 39, which the one at 40 shows.
console 0 core=test
option 0 link_test_render soft
option 0 link_test_dupe_frames 40-50
30 save mid
40 checkpoint before
41 checkpoint dupe
60 checkpoint after
90 end
