# Membership: a cable pulled and plugged back in, a core's own detach and
# re-attach of its port, and a hold with messages for the held console.
console 0 core=test
console 1 core=test
option 0 link_test_send_frames 0-49,100-109
option 1 link_test_send_frames 0-49
option 1 link_test_detach_0 40
option 1 link_test_reattach_0 45
0 cable 0:0 1:0
20 uncable 0:0
25 expect 0 system 9 0
25 expect 0 system 12 255
30 cable 0:0 1:0
35 expect 0 system 9 2
42 expect 0 system 9 0
47 expect 0 system 9 2
90 hold 1
95 expect 0 system 9 2
105 save mid
105 checkpoint in_flight # a message in flight while console 1 is held
120 unhold 1
125 checkpoint middle
140 end
